<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" id="your.app.id" version="1.0.0" tizen:api-version="4.0">
    <name>Your App Name</name>
    <description>Your app description</description>
    <author email="your.email@example.com" href="http://example.com">Your Name</author>
    <icon src="images/icon.png"/> <!-- Update this line with your new icon -->
    <tizen:icon src="images/tv_icon.png"/> <!-- Update this line if needed -->
    <content src="index.html"/>
    <access origin="*"/>
    <feature name="http://tizen.org/feature/network.wifi"/>
    <feature name="http://tizen.org/feature/network.mobile.data"/>
</widget>
